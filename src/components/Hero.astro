  <div class="flex flex-col gap-5">
    <div>
      <p class="text-xl">Hi, my name is</p>

      <h1 class="py-3 text-3xl font-bold xl:text-6xl">
        Fang Wei Jie
      </h1>

      <p class="py-1 2xl:w-[60%]">
        <span class="text-xl xl:text-2xl">
